# Runtime configuration is supplied by CLI arguments and Pi's provider plumbing.
# Keep provider-neutral; real credentials belong in Infisical, never project env files.
# @defaultSensitive=true
# ---

# @required=false
OPENAI_API_KEY=

# @required=false
ANTHROPIC_API_KEY=

# @required=false
ANTHROPIC_OAUTH_TOKEN=

# @required=false
# @sensitive=false
# @type=url
ADM_LIFECYCLE_URL=http://127.0.0.1:7433

# @required=false
# @sensitive=false
# @type=string
ADM_LIFECYCLE_NAMESPACE=adm-system

# @required=false
# @sensitive=false
# @type=path
ADM_LIFECYCLE_TOKEN_FILE=
