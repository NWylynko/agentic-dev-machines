#!/bin/sh
# adm claude (TASK-90): one long-lived Claude Code per workspace, with Remote
# Control on, inside the tmux session "claude". It runs whether or not a
# terminal is attached; detaching (Ctrl-b d) leaves it running.
#   start   mark Claude enabled on the workspace volume; start it if not running
#   start --task  a bot's Claude Code agent (harness claude, TASK-141): the
#           lifecycle passes the task on stdin once the workspace is ready
#   attach  start, then attach this terminal
#   boot    container start: start it only if it was ever enabled here
#   run [CLAUDE ARGS]  exec Claude as the tmux session runs it: the
#           workspace's config dir, its MCP config, and the diet below
#   credentials-loop  the claude-credentials session: rewrite the login when
#           due. The one timer; a shell + sleep, so it holds ~2 MB, not Node.
set -eu
state=${ADM_CLAUDE_STATE:-/workspace/.adm/claude}
config=${ADM_WORKSPACE_CONFIG:-/run/adm/workspace.json}
action=${1:-}
case "$action" in
  start | attach | boot) ;;
  run)
    shift
    prompt="You have a built-in browser in this workspace: headless Chromium driven by the mcp__browser__* tools (browser_navigate, browser_snapshot, browser_click, browser_take_screenshot, ...). It sees the workspace's own network, so use it to open dev servers on localhost. Pages and cookies are discarded when the workspace restarts."
    repositories=$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).repositories === true' "$config")
    if [ "$repositories" = true ]; then
      # With /repos, ignored files live on node-local disk (TASK-81). Keep this
      # text identical to packages/runner/src/ignored-files.ts (a test checks).
      prompt="$prompt

Files git ignores inside /repos checkouts (node_modules, build output, .env, local databases) are kept on this machine's local disk, not with the workspace: they are deleted whenever this workspace's Pod is replaced (updates, moves to another node). When they are missing, reinstall dependencies and recreate ignored files such as .env. Put anything that must survive in a file git does not ignore."
    fi
    set -- --append-system-prompt "$prompt" "$@"
    # The diet: every turn carries only what a coding agent needs, like Pi.
    # Built-in tools are the kept set (image/claude-diet.test.mjs); MCP tools
    # stay behind ToolSearch. Off: bundled skills, the claude.ai account's
    # connectors and synced skills (skillOverrides; the names it syncs today,
    # checked live with /context), and Claude in Chrome. The config dir is on
    # the volume, so login, trust answers and conversations survive Pod
    # restarts and moves.
    export CLAUDE_CONFIG_DIR="$state/config" DISABLE_AUTOUPDATER=1 \
      CLAUDE_CODE_DISABLE_BUNDLED_SKILLS=1 ENABLE_CLAUDEAI_MCP_SERVERS=false
    harness=$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).harness ?? "pi"' "$config")
    if [ "$harness" = claude ]; then
      # A bot's Claude Code agent (TASK-141) runs with nobody to answer a
      # screen: onboarding done, /workspace, /repos and this checkout trusted,
      # its CLAUDE.md imports approved, and every permission granted like Pi
      # (TASK-39). research/claude-code/tui-driving.md has the keys. Prints
      # "yes" when this checkout already has a conversation.
      conversation=$(node -e '
        const fs = require("fs"), path = require("path");
        const directory = process.argv[1], file = path.join(directory, ".claude.json");
        let settings = {};
        try { settings = JSON.parse(fs.readFileSync(file, "utf8")); } catch (error) { if (error.code !== "ENOENT") throw error; }
        // Claude keys projects by the physical cwd (/repos is a symlink).
        const cwd = fs.realpathSync(process.cwd());
        const projects = settings.projects ?? {};
        for (const trusted of ["/workspace", "/repos", cwd])
          projects[trusted] = { ...projects[trusted], hasTrustDialogAccepted: true };
        Object.assign(projects[cwd], { hasClaudeMdExternalIncludesApproved: true, hasClaudeMdExternalIncludesWarningShown: true });
        fs.mkdirSync(directory, { recursive: true });
        fs.writeFileSync(`${file}.adm-tmp`, JSON.stringify({ ...settings, hasCompletedOnboarding: true, projects }, null, 2));
        fs.renameSync(`${file}.adm-tmp`, file);
        let transcripts = [];
        try { transcripts = fs.readdirSync(path.join(directory, "projects", cwd.replace(/[^a-zA-Z0-9]/g, "-"))); } catch (error) { if (error.code !== "ENOENT") throw error; }
        process.stdout.write(transcripts.some((name) => name.endsWith(".jsonl")) ? "yes" : "no");
      ' "$CLAUDE_CONFIG_DIR")
      model=$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).model?.id ?? ""' "$config")
      set -- --dangerously-skip-permissions "$@"
      if [ -n "$model" ]; then set -- --model "$model" "$@"; fi
      if [ "$conversation" = yes ]; then
        # A restarted Pod resumes the conversation; the task was delivered
        # with it and is never sent again.
        if [ -f "$state/task" ]; then rm "$state/task"; fi
        set -- "$@" --continue
      elif [ -f "$state/task" ]; then
        # First start: the task is Claude's first prompt, as an argument, so
        # it is submitted once Claude is ready with no paste race. It stays
        # on the volume until a conversation exists, so a Pod that dies first
        # still delivers it.
        set -- "$@" "$(cat "$state/task")"
      fi
    fi
    # skipDangerousModePermissionPrompt: --dangerously-skip-permissions starts
    # without its warning screen (harness claude only passes the flag).
    exec claude --mcp-config "$state/mcp.json" --no-chrome \
      --tools "Bash,Read,Edit,Write,Glob,Grep,ToolSearch,Skill,AskUserQuestion" \
      --settings '{"skipDangerousModePermissionPrompt":true,"skillOverrides":{"built-in-browser":"off","plugin-authoring":"off","chrome-browser":"off","computer-use":"off","deep-research":"off","docs":"off","docx":"off","pdf":"off","pptx":"off","xlsx":"off"}}' \
      "$@"
    ;;
  credentials-loop)
    while :; do
      # A failure is logged by the writer; Claude keeps the last token until
      # it expires, then shows the login as expired. Ask again in a minute.
      due=$(adm-claude-credentials write "$state/config") || due=60
      sleep "$due"
    done
    ;;
  *) echo "usage: adm-claude start|attach|boot|run" >&2; exit 2 ;;
esac
if [ "$action" = boot ] && [ ! -f "$state/enabled" ]; then exit 0; fi
mkdir -p "$state/config"
: > "$state/enabled"
if [ "$action" = start ] && [ "${2:-}" = --task ]; then
  cat > "$state/task.tmp"
  mv "$state/task.tmp" "$state/task"
fi
# Installation MCP connectors, refreshed on every start and attach. Tokens are
# fetched per connection by its headersHelper; none are written here.
adm-claude-mcp config "$state/mcp.json"
# The installation's Claude login (adm login claude): an access token only,
# rewritten before it expires by the claude-credentials session, whose log is
# $state/credentials.log. Without a login this fails and Claude does not start.
# "=NAME" matches the session exactly: plain "claude" would prefix-match
# "claude-credentials".
if ! tmux has-session -t =claude-credentials 2>/dev/null; then
  adm-claude-credentials write "$state/config" > /dev/null
  tmux new-session -d -s claude-credentials \
    "exec adm-claude credentials-loop >> '$state/credentials.log' 2>&1"
fi
if ! tmux has-session -t =claude 2>/dev/null; then
  name=$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).name' "$config")
  cwd=$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).cwd' "$config")
  tmux new-session -d -s claude -x 200 -y 50 -c "$cwd" \
    adm-claude run --remote-control "$name"
fi
if [ "$action" = attach ]; then
  # kubectl exec passes no TERM; tmux needs one to draw the client.
  TERM=xterm-256color exec tmux attach-session -t =claude
fi
