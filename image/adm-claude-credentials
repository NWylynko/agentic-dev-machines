#!/usr/bin/env node
// Claude Code's login in this Pod (TASK-90). `adm login claude` is held and
// refreshed only by the cluster authority; refresh tokens are single use, so a
// Pod that refreshed would log every other Pod out. This writes
// CLAUDE_CONFIG_DIR/.credentials.json with a current access token and no
// refresh token, and the account into .claude.json, from
// POST /v1/runtime/claude/credentials. Claude re-reads the file when it changes.
//   write DIR  once; fails loudly (exit 1) if the installation has no login
//   loop DIR   write, then rewrite 10 min before each token expires, forever.
//              The one timer: logs every write and failure as a JSON line.
(async () => {
  const fs = process.getBuiltinModule("node:fs");
  const path = process.getBuiltinModule("node:path");
  const [action, directory] = process.argv.slice(2);
  const log = (level, event, fields = {}) =>
    process.stderr.write(
      `${JSON.stringify({ time: new Date().toISOString(), level, event, ...fields })}\n`,
    );
  if (!["write", "loop"].includes(action) || !directory) {
    process.stderr.write("usage: adm-claude-credentials write|loop DIR\n");
    process.exit(2);
  }
  const replace = (file, value) => {
    fs.writeFileSync(`${file}.adm-tmp`, `${JSON.stringify(value, null, 2)}\n`, {
      mode: 0o600,
    });
    fs.renameSync(`${file}.adm-tmp`, file);
  };
  async function writeClaudeCredentials() {
    const base = process.env.ADM_LIFECYCLE_URL;
    if (!base) throw new Error("ADM_LIFECYCLE_URL is not set");
    const identity = fs
      .readFileSync(
        process.env.ADM_LIFECYCLE_TOKEN_FILE ||
          "/var/run/secrets/kubernetes.io/serviceaccount/token",
        "utf8",
      )
      .trim();
    const response = await fetch(
      `${base.replace(/\/$/, "")}/v1/runtime/claude/credentials`,
      {
        method: "POST",
        headers: {
          authorization: `Bearer ${identity}`,
          "content-type": "application/json",
        },
        body: "{}",
        signal: AbortSignal.timeout(30_000),
      },
    );
    const value = await response.json().catch(() => ({}));
    if (!response.ok)
      throw new Error(
        value.error?.message ??
          `the lifecycle controller answered ${response.status}; run adm login claude`,
      );
    fs.mkdirSync(directory, { recursive: true, mode: 0o700 });
    replace(path.join(directory, ".credentials.json"), {
      claudeAiOauth: {
        accessToken: value.accessToken,
        refreshToken: null,
        expiresAt: value.expiresAt,
        scopes: value.scopes,
        subscriptionType: value.subscriptionType,
      },
    });
    // Claude owns .claude.json and rewrites it while running: touch it only
    // when the account changed.
    const settingsFile = path.join(directory, ".claude.json");
    let settings = {};
    try {
      settings = JSON.parse(fs.readFileSync(settingsFile, "utf8"));
    } catch (error) {
      if (error.code !== "ENOENT") throw error;
    }
    if (
      settings.hasCompletedOnboarding !== true ||
      settings.oauthAccount?.accountUuid !== value.oauthAccount.accountUuid ||
      settings.oauthAccount?.organizationUuid !==
        value.oauthAccount.organizationUuid
    )
      replace(settingsFile, {
        ...settings,
        hasCompletedOnboarding: true,
        oauthAccount: { ...settings.oauthAccount, ...value.oauthAccount },
      });
    log("info", "claude_credentials_written", {
      expires: new Date(value.expiresAt).toISOString(),
    });
    return value.expiresAt;
  }
  if (action === "write") {
    try {
      await writeClaudeCredentials();
    } catch (error) {
      log("error", "claude_credentials_failed", { message: error.message });
      process.stderr.write(`adm-claude-credentials: ${error.message}\n`);
      process.exit(1);
    }
    return;
  }
  for (;;) {
    let delayMs;
    try {
      delayMs = (await writeClaudeCredentials()) - Date.now() - 10 * 60 * 1000;
    } catch (error) {
      // Claude keeps the last token until it expires, then shows the login
      // as expired; keep asking once a minute meanwhile.
      log("error", "claude_credentials_failed", { message: error.message });
      delayMs = 60 * 1000;
    }
    await new Promise((resolve) => setTimeout(resolve, Math.max(delayMs, 60 * 1000)));
  }
})();
