#!/bin/sh
# The workspace's built-in browser (Pi and Claude Code alike): the pinned
# Playwright MCP server over stdio, driving the image's chromium. One launcher
# so both agents get the same browser.
#   adm-browser-mcp OUTPUT_DIR   screenshots, snapshots and its config; never
#   the cwd, which may be the read-only /repos catalog
#
# Sites see a person's desktop Chrome, not a headless bot
# (image/browser-human.test.mjs): Chrome's User-Agent for the installed
# version instead of "HeadlessChrome", a 1920x1080 screen with a window frame
# around the page, and no automation flag. Still visible: WebGL is
# SwiftShader (no GPU in a Pod), and CDP-level checks.
set -eu
if [ -z "${1:-}" ]; then
  echo "usage: adm-browser-mcp OUTPUT_DIR" >&2
  exit 2
fi
output=$1
chromium=${ADM_BROWSER_CHROMIUM:-/usr/bin/chromium}
mkdir -p "$output"
version=$("$chromium" --version | grep -oE '[0-9]+\.[0-9.]+' | head -n 1 | cut -d . -f 1)
if [ -z "$version" ]; then
  echo "adm-browser-mcp: cannot read the version of $chromium" >&2
  exit 1
fi
cat > "$output/browser-config.json" <<'JSON'
{
  "browser": {
    "launchOptions": {
      "args": [
        "--window-size=1920,1080",
        "--screen-info={1920x1080}",
        "--disable-blink-features=AutomationControlled"
      ],
      "ignoreDefaultArgs": ["--enable-automation"]
    },
    "contextOptions": { "viewport": null }
  }
}
JSON
exec node "${ADM_PLAYWRIGHT_MCP_CLI:-/opt/adm/node_modules/@playwright/mcp/cli.js}" \
  --headless --isolated \
  `# The Pod drops the capabilities Chromium's sandbox needs (as image/browser.mjs).` \
  --no-sandbox \
  --executable-path "$chromium" \
  --output-dir "$output" \
  --config "$output/browser-config.json" \
  --user-agent "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/$version.0.0.0 Safari/537.36"
