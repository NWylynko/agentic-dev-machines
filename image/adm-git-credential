#!/bin/sh
set -eu

operation=${1:-get}
case "$operation" in
  store)
    exit 0
    ;;
  erase)
    if [ -z "${GH_TOKEN:-}" ]; then
      "$(dirname "$0")/adm-github-token" rejected >/dev/null 2>&1 || true
    fi
    echo "adm-git-credential: GitHub rejected this token. If it is the cluster login, run adm repos login github. If this workspace uses a GH_TOKEN Secret, check the GH_TOKEN Secret and its repository write permission, then rotate the Secret if the token was revoked." >&2
    exit 0
    ;;
  get)
    ;;
  *)
    exit 0
    ;;
esac

protocol=
host=
while IFS= read -r line; do
  case "$line" in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done

if [ "$protocol" != https ]; then
  exit 0
fi

case "$host" in
  github.com|github.com:443)
    ;;
  *)
    exit 0
    ;;
esac

# A workspace GH_TOKEN Secret (--credential-env) overrides the cluster login.
token=${GH_TOKEN:-}
if [ -z "$token" ]; then
  token=$("$(dirname "$0")/adm-github-token") || exit 1
fi

printf 'protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n\n' "$token"
