#!/bin/sh
set -eu

operation=${1:-get}
case "$operation" in
  store)
    exit 0
    ;;
  erase)
    echo "adm-git-credential: GitHub rejected this workspace token. Check the GH_TOKEN Secret and its repository write permission, then rotate the Secret if the token was revoked." >&2
    exit 0
    ;;
  get)
    ;;
  *)
    exit 0
    ;;
esac

protocol=
host=
while IFS= read -r line; do
  case "$line" in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done

if [ "$protocol" != https ]; then
  exit 0
fi

case "$host" in
  github.com|github.com:443)
    ;;
  *)
    exit 0
    ;;
esac

if [ -z "${GH_TOKEN:-}" ]; then
  echo "adm-git-credential: GitHub HTTPS authentication requires an explicit workspace GH_TOKEN Secret. Configure --credential-env GH_TOKEN=SECRET:KEY with a token that can write this repository." >&2
  exit 1
fi

printf 'protocol=https\nhost=github.com\n\n' | exec gh auth git-credential get
