#!/bin/sh
# The development container stays up after the terminal detaches.
# Kubernetes keeps the image's Tini entrypoint so it can forward signals here.
# `exec` lets Tini deliver them directly to the workspace wait process.
set -eu
if [ "${1:-}" = "--check" ]; then
  test "$(readlink /repos)" = "/workspace/.adm/catalog"
  test -f /opt/adm/workspace-env.mjs
  test -f /opt/adm/runner.mjs
  test -d /opt/adm/node_modules/@earendil-works/pi-durable
  test -x /usr/local/bin/adm-init-workspace
  test -x /usr/bin/zsh
  test -f /usr/local/share/adm/zshrc
  test -f /usr/local/share/adm/zsh-identity.zsh
  test -L /home/node/.zshrc
  test "$(readlink /home/node/.zshrc)" = /workspace/.adm/zsh/.zshrc
  test "$(getent passwd node | cut -d: -f7)" = /usr/bin/zsh
  grep -q '/usr/local/share/adm/zsh-identity.zsh' /etc/zsh/zshrc
  test -f /opt/adm/oh-my-zsh/oh-my-zsh.sh
  # ADM's own Node, which the runner and helpers use, comes from the image; fnm
  # installs any other version onto the work volume.
  test "$(command -v node)" = /usr/local/bin/node
  test "$(node --version)" = "v${ADM_NODE_VERSION:?}"
  test -x /usr/local/bin/fnm
  test "$FNM_DIR" = /workspace/.adm/fnm
  test "$(getent passwd node | cut -d: -f1,3,4,6)" = node:1000:1000:/home/node
  if [ "${2:-code}" = "code" ]; then
    test -f /opt/adm/browser.mjs
    test -x /usr/local/bin/adm-git-credential
    test -x /usr/local/bin/adm-github-token
    test -x /usr/local/bin/adm-git-identity
    test "$(git config --system --get include.path)" = /workspace/.adm/gitconfig
    test "$(command -v gh)" = /usr/local/bin/gh
    test -x /usr/bin/gh
    test -x /usr/local/bin/adm-claude
  fi
  exit 0
fi
if [ "$#" -gt 0 ]; then
  exec "$@"
fi
# Default Git author from the workspace's GitHub account. In the background:
# GitHub being slow or the cluster not logged in must not hold up the runner.
# The subshell hands it to Tini, which reaps it; the exec'd runner would not.
if command -v adm-git-identity >/dev/null 2>&1; then
  (adm-git-identity &)
fi
# Bring back the Claude Code session of a workspace that ran `adm claude`
# (TASK-90). A failure is logged and left for the next `adm claude`, which
# shows it; the Pi agent still starts.
if command -v adm-claude >/dev/null 2>&1; then
  adm-claude boot || echo "adm-claude: Claude Code did not start; run adm claude NAME to see why" >&2
fi
exec node /opt/adm/runner.mjs \
  --host 0.0.0.0 \
  --port 7432 \
  --state-dir /workspace/.adm/runtime \
  --workspace-config /run/adm/workspace.json \
  --token-file /var/run/secrets/kubernetes.io/serviceaccount/token \
  --lifecycle-url "${ADM_LIFECYCLE_URL:?ADM_LIFECYCLE_URL must be set}" \
  --pod-uid "${ADM_POD_UID:?ADM_POD_UID must be set}"
