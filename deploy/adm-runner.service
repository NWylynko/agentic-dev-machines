# Prefer `adm setup`, which generates this service with the actual Node PATH.
# For manual installation, copy to ~/.config/systemd/user/adm-runner.service
# and include your Node.js 24+ directory in Environment=PATH below.
# Enable with: systemctl --user enable --now adm-runner.service
# Persistent user services after logout also require operator-configured lingering.
[Unit]
Description=ADM durable coding and bot runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/adm serve
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=default.target
